# =============================================================================
# Trial Booking System — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your local environment.
# .env is git-ignored and should NEVER be committed.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trial_booking"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Environment: development | production
NODE_ENV=development

# Server port (default: 3000)
PORT=3000

# Logging level: debug | info | warn | error
LOG_LEVEL=debug
