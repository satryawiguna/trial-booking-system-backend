{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/api",
  "sourceRoot": "apps/api/src",
  "compilerOptions": {
    "webpack": false,
    "tsConfigPath": "apps/api/tsconfig.json",
    "deleteOutDir": true
  },
  "projects": {
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.json"
      }
    },
    "trial-classes": {
      "type": "library",
      "root": "libs/trial-classes",
      "entryFile": "index",
      "sourceRoot": "libs/trial-classes",
      "compilerOptions": {
        "tsConfigPath": "libs/trial-classes/tsconfig.json"
      }
    },
    "bookings": {
      "type": "library",
      "root": "libs/bookings",
      "entryFile": "index",
      "sourceRoot": "libs/bookings",
      "compilerOptions": {
        "tsConfigPath": "libs/bookings/tsconfig.json"
      }
    },
    "payments": {
      "type": "library",
      "root": "libs/payments",
      "entryFile": "index",
      "sourceRoot": "libs/payments",
      "compilerOptions": {
        "tsConfigPath": "libs/payments/tsconfig.json"
      }
    },
    "parents": {
      "type": "library",
      "root": "libs/parents",
      "entryFile": "index",
      "sourceRoot": "libs/parents",
      "compilerOptions": {
        "tsConfigPath": "libs/parents/tsconfig.json"
      }
    },
    "auth": {
      "type": "library",
      "root": "libs/auth",
      "entryFile": "index",
      "sourceRoot": "libs/auth",
      "compilerOptions": {
        "tsConfigPath": "libs/auth/tsconfig.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.json"
      }
    },
    "logger": {
      "type": "library",
      "root": "libs/logger",
      "entryFile": "index",
      "sourceRoot": "libs/logger",
      "compilerOptions": {
        "tsConfigPath": "libs/logger/tsconfig.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.json"
      }
    }
  }
}
